# Mehman Mira - Environment Configuration
# Copy this file to .env and configure the variables for your local environment.

# ==========================================
# Core API Settings
# ==========================================

# Your Google Gemini API Key (Required)
# Must be a valid string (min length > 0)
GOOGLE_API_KEY="your_api_key_here"

# The Gemini model to use for the agent
# Options: "gemini-2.0-flash", "gemini-2.0-pro-exp", etc.
GEMINI_MODEL="gemini-2.0-flash"

# ==========================================
# Storage & Paths
# ==========================================

# Path to the SQLite availability database
# Default: data/availability_db/src/availability.db
DB_PATH="data/availability_db/src/availability.db"

# Path to the properties JSON dataset
# Default: data/properties/src/properties.json
PROPERTIES_PATH="data/properties/src/properties.json"

# Directory where active user session contexts are stored
# Default: sessions/
SESSION_DIR="sessions/"

# ==========================================
# Application Behavior
# ==========================================

# Timeout in seconds when waiting to acquire a file lock for concurrent session writes
# Default: 5
SESSION_LOCK_TIMEOUT=5

# Maximum allowed characters for user input to prevent ReDoS
# Default: 500
MAX_USER_INPUT_LENGTH=500

# Enable verbose debug logging output
# Options: True, False
DEBUG=False
